#!/bin/sh
# Gate lokal WZ MANAGE PRO.
#
# GitHub Actions saat ini tidak berjalan (billing), jadi hook ini menjadi
# jaring pengaman terakhir sebelum kode sampai ke main. Kalau test gagal,
# commit dibatalkan.
#
# Aktifkan di clone baru dengan:  git config core.hooksPath .githooks
# Bypass sengaja:                   git commit --no-verify
set -e

ROOT=$(git rev-parse --show-toplevel)

if [ ! -d "$ROOT/web-source" ]; then
  echo "pre-commit: web-source tidak ditemukan, lewati."
  exit 0
fi

cd "$ROOT/web-source"

echo "pre-commit: menjalankan npm test..."
if ! npm test; then
  echo ""
  echo "======================================================"
  echo " COMMIT DIBATALKAN - test gagal."
  echo " Perbaiki dulu, atau bypass dengan: git commit --no-verify"
  echo "======================================================"
  exit 1
fi

exit 0
